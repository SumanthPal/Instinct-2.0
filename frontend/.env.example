# ==============================================================================
# Instinct 2.0 - Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required at runtime (lazy-loaded on first client/server request)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable API key (sb_publishable_... format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Supabase secret key (optional: only required for server-side elevated admin calls)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Application Endpoints (Optional)
# ------------------------------------------------------------------------------
# Backend API base URL (default: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical frontend site URL for auth redirects (default: window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
