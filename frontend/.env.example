# ==============================================================================
# Instinct 2.0 - Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NOTE: Do NOT wrap values in quotes. Docker's --env-file passes quotes literally,
# which can corrupt variables across containerized environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required at runtime (lazy-loaded on first client/server request)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable API key (sb_publishable_... format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Google OAuth client ID for the sign-in button. Must match the client ID set
# under Authentication > Providers > Google in Supabase, and this site's origin
# must be an Authorized JavaScript origin on that client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase secret key (optional: only required for server-side elevated admin calls)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Application Endpoints (Optional)
# ------------------------------------------------------------------------------
# Backend API base URL (default: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

