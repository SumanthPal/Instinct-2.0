# ==============================================================================
# Instinct 2.0 - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# NOTE: Do NOT wrap values in quotes (e.g. use S3_REGION=auto, not S3_REGION="auto").
# Docker's --env-file / docker-compose does not strip quotes and passes them literally.
#
# Services:
#   - Web API: SUPABASE_*, REDIS_URL, INTERNAL_API_TOKEN, S3_* (optional: PORT, LOG_DIR)
#   - Scraper: SUPABASE_*, REDIS_URL, S3_*, OPENAI_*, INSTAGRAM_*, COOKIE_*
#   - Job Bot: JOB_BOT_*, SERVER_ID, USER_ID, REDIS_URL
#   - Aux Bot: AUX_BOT_*, SERVER_ID, USER_ID, REDIS_URL, INTERNAL_API_TOKEN
# ==============================================================================

# ------------------------------------------------------------------------------
# Core / Database (Supabase)
# Required by: Web API, Scraper, Discord Bots, Embeddings Scripts
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase secret API key (sb_secret_... format, replaces legacy service_role key)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# ------------------------------------------------------------------------------
# Redis Cache & Job Queue
# Required by: Web API (logging), Scraper (queue), Discord Bots (queue/status)
# ------------------------------------------------------------------------------
# Redis connection URL.
# Redis Cloud free tier provides 30 MB memory and ~30 concurrent connections.
# Each process bounds its connection pool (max_connections=5).
# For secure remote connections over the internet, use the rediss:// TLS scheme.
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Internal Service Authentication
# Required by: Web API, Aux Bot, Scraper
# ------------------------------------------------------------------------------
# Shared secret token for authenticating internal backend API endpoints
INTERNAL_API_TOKEN=your_internal_api_token_here

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port for FastAPI web server (default: 8000)
PORT=8000

# Directory for file logs (defaults to OS-specific application log directory)
# LOG_DIR=

# ------------------------------------------------------------------------------
# OpenAI (AI Validation & Embeddings)
# Required by: Scraper (event parsing), Embeddings script (populate_embeds)
# ------------------------------------------------------------------------------
# OpenAI API key for event extraction and text embeddings
OPENAI_API_KEY=sk-your_openai_api_key_here

# OpenAI model for caption -> event JSON parsing (default: gpt-4.1-mini)
OPENAI_EVENT_MODEL=gpt-4.1-mini

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3-Compatible Object Storage
# Required by: Scraper (mirrored images), Web API (serving CDN image URLs)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=   # account root, e.g. https://<account>.r2.cloudflarestorage.com — NO bucket path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=         # e.g. instinct-images
S3_REGION=auto     # R2 requires "auto"
S3_PUBLIC_URL=     # public read prefix, e.g. https://pub-<hash>.r2.dev

# ------------------------------------------------------------------------------
# Discord Bots Configuration
# Required by: Job Bot (job_bot.py) and Auxiliary Bot (auxiliary_bot.py)
# ------------------------------------------------------------------------------
# Discord server (guild) ID to restrict bot operations
SERVER_ID=

# Discord user ID of the bot owner for alert notifications
USER_ID=

# Job Bot (Scraper queue management)
JOB_BOT_TOKEN=
JOB_BOT_PREFIX=!
JOB_BOT_CHANNEL_ID=
JOB_BOT_ERROR_CHANNEL_ID=
JOB_BOT_ADMIN_ROLE_ID=

# Auxiliary Bot (Interactive commands & tag verification)
AUX_BOT_TOKEN=
AUX_BOT_PREFIX=?
AUX_BOT_CHANNEL_ID=
AUX_BOT_ADMIN_ROLE_ID=

# ------------------------------------------------------------------------------
# Instagram Scraper & Selenium Configuration
# Required by: Scraper (insta_scraper.py / scraper container)
# ------------------------------------------------------------------------------
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
COOKIE_1=
COOKIE_2=

# Selenium / Chrome paths (optional: needed when running in Docker/headless Linux)
# CHROME_BIN=/usr/bin/chromium
# GOOGLE_CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# DOCKER_ENV=true
